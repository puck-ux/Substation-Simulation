# Target configuration for the substation attack scripts.
# Copy this file to targets.env and fill in the current values:
#   cp targets.env.example targets.env
#
# Get the IPs and MACs from VM3 while VM1 and VM2 are running:
#   ping -c 2 <vm1_ip>   &&  ip neigh    # shows VM1's MAC
#   ping -c 2 <vm2_ip>   &&  ip neigh    # shows VM2's MAC
# Get VM3's own interface name with:  ip addr

# VM1 — OpenPLC / outstation (the PLC)
VM1_IP=192.168.68.110
VM1_MAC=08:00:27:ea:67:d7

# VM2 — dnp3master / SCADA master
VM2_IP=192.168.68.111
VM2_MAC=08:00:27:04:e1:8b

# VM3 — this attacker box: the network interface the attacks use
IFACE=enp0s3
