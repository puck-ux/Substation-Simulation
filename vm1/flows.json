    {
        "id": "a988b31f466377dc",
        "type": "function",
        "z": "2d7997ad2a7d55e5",
        "name": "PLC1 Health Check",
        "func": "var client = new net.Socket();\nclient.setTimeout(1000);\n\nclient.connect(502, \"172.17.0.2\", function() {\n    client.end();\n    // PLC 1 is up\n    if (global.get(\"active\") === \"backup\") {\n        global.set(\"active\", \"primary\");\n        global.set(\"failCount\", 0);\n        node.warn(\"PLC 1 back - switching to primary\");\n        node.send([null, { payload: false }]);\n    } else {\n        global.set(\"failCount\", 0);\n    }\n});\n\nclient.on('error', function() {\n    client.end();\n    var failCount = global.get(\"failCount\") || 0;\n    failCount++;\n    global.set(\"failCount\", failCount);\n    if (failCount >= 3 && global.get(\"active\") === \"primary\") {\n        global.set(\"active\", \"backup\");\n        global.set(\"failCount\", 0);\n        node.warn(\"PLC 1 down - switching to backup\");\n        node.send([{ payload: true }, null, { payload: global.get(\"lastSwitch\") ? 1 : 0 }]);\n    }\n});\nclient.on('timeout', function() {\n    client.end();\n});\n\nreturn null;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "net",
                "module": "net"
            }
        ],
