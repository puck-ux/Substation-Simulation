    {
        "id": "23e29a9ac6f61926",
        "type": "function",
        "z": "2d7997ad2a7d55e5",
        "name": "Failover Handler",
        "func": "var failCount = global.get(\"failCount\") || 0;\nvar active = global.get(\"active\") || \"primary\";\n\nif (active === \"primary\") {\n    failCount++;\n    global.set(\"failCount\", failCount);\n    if (failCount >= 3) {\n        global.set(\"active\", \"backup\");\n        global.set(\"failCount\", 0);\n        node.warn(\"PLC 1 down - switching to backup\");\n        return { payload: true };\n    }\n} \nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
